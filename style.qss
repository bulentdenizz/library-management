/* style.qss - Tailwind CSS inspired theme for PyQt6 */

QMainWindow, QDialog {
    background-color: #f3f4f6; /* gray-100 */
    color: #1f2937; /* gray-800 */
    font-family: 'Segoe UI', Inter, Roboto, Helvetica, Arial, sans-serif;
    font-size: 14px;
}

QGroupBox {
    background-color: #ffffff;
    border: 1px solid #e5e7eb; /* gray-200 */
    border-radius: 8px;
    margin-top: 20px;
    padding: 15px;
    font-size: 14px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 4px 8px;
    color: #4b5563; /* gray-600 */
    font-weight: bold;
    background-color: #f3f4f6;
    border-radius: 6px;
    margin-left: 10px;
}

QPushButton {
    background-color: #3b82f6; /* blue-500 */
    color: white;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #2563eb; /* blue-600 */
}

QPushButton:pressed {
    background-color: #1d4ed8; /* blue-700 */
}

QLineEdit, QComboBox {
    background-color: #ffffff;
    border: 1px solid #d1d5db; /* gray-300 */
    border-radius: 6px;
    padding: 8px 12px;
    color: #1f2937;
    selection-background-color: #3b82f6;
}

QLineEdit:focus, QComboBox:focus {
    border: 1px solid #3b82f6;
}

QComboBox::drop-down {
    border: none;
    width: 30px;
}

QComboBox::down-arrow {
    image: none; /* remove default arrow */
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 5px solid #6b7280; /* gray-500 */
    margin-right: 10px;
}

QTableWidget {
    background-color: #ffffff;
    alternate-background-color: #f9fafb; /* gray-50 */
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    gridline-color: #e5e7eb;
    selection-background-color: #eff6ff; /* blue-50 */
    selection-color: #1d4ed8; /* blue-700 */
    color: #1f2937; /* Default text color mapping to gray-800 */
}

QTableWidget::item {
    color: #1f2937; /* Ensure item text is visible */
}

QHeaderView::section {
    background-color: #f9fafb;
    color: #4b5563;
    font-weight: bold;
    border: none;
    border-bottom: 1px solid #e5e7eb;
    border-right: 1px solid #e5e7eb;
    padding: 8px;
}

QTabWidget::pane {
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    background: #ffffff;
}

QTabBar::tab {
    background: #f3f4f6;
    color: #6b7280;
    border: 1px solid transparent;
    padding: 10px 20px;
    margin-right: 4px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}

QTabBar::tab:selected {
    background: #ffffff;
    color: #3b82f6;
    border: 1px solid #e5e7eb;
    border-bottom-color: #ffffff;
    font-weight: bold;
}

QTabBar::tab:hover:!selected {
    background: #e5e7eb;
}

QLabel {
    color: #374151; /* gray-700 */
    font-weight: 500;
}
